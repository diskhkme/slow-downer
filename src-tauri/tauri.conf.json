{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slow Downer",
  "version": "../package.json",
  "identifier": "com.hkkim.slowdowner",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Slow Downer",
        "width": 1280,
        "height": 780,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Hyungki Kim",
    "shortDescription": "연주 연습용 오디오 플레이어 (속도/피치 조절, 루프)",
    "copyright": "Copyright (c) 2026 Hyungki Kim",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    }
  }
}
